<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <title>7075.uz — Admin Panel</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container py-5">
        <h1 class="mb-4 text-center">🚗 7075.uz Admin Panel</h1>

        <!-- Statistika kartochkalari -->
        <div class="row text-center mb-4">
            <div class="col-md-3"><div class="p-3 bg-white shadow-sm rounded"><h5>Haydovchilar</h5><h3><%= DB.drivers.length %></h3></div></div>
            <div class="col-md-3"><div class="p-3 bg-white shadow-sm rounded"><h5>Yo'lovchilar</h5><h3><%= DB.passengers.length %></h3></div></div>
            <div class="col-md-3"><div class="p-3 bg-white shadow-sm rounded"><h5>Faol E'lonlar</h5><h3><%= DB.listings.length %></h3></div></div>
            <div class="col-md-3"><div class="p-3 bg-white shadow-sm rounded"><h5>Band qilinganlar</h5><h3><%= DB.matches.length %></h3></div></div>
        </div>

        <!-- E'lonlar jadvali -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-dark text-white"><b>E'lonlar va Safarlar</b></div>
            <div class="card-body table-responsive">
                <table class="table table-bordered align-middle">
                    <thead>
                        <tr>
                            <th>ID / Haydovchi</th>
                            <th>Yo'nalish</th>
                            <th>Mashina</th>
                            <th>Vaqt</th>
                            <th>Narx (so'm)</th>
                            <th>Status</th>
                            <th>Amallar</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if(DB.listings.length === 0) { %>
                            <tr><td colspan="7" class="text-center text-muted">Hozircha e'lonlar yo'q</td></tr>
                        <% } else { %>
                            <% DB.listings.forEach(l => { %>
                            <tr>
                                <td><b><%= l.id %></b><br><small><%= l.driverName %> (<%= l.driverPhone %>)</small></td>
                                <td><%= l.from %> → <%= l.to %></td>
                                <td><%= l.carType %><br><small><%= l.licensePlate %></small></td>
                                <td><%= l.date %> | <%= l.time %></td>
                                
                                <!-- Tahrirlash formasi -->
                                <form action="/admin/listing/update/<%= l.id %>" method="POST">
                                    <td><input type="number" name="price" value="<%= l.price %>" class="form-control form-control-sm" style="width: 100px;"></td>
                                    <td>
                                        <select name="status" class="form-select form-select-sm">
                                            <option value="active" <%= l.status==='active'?'selected':'' %>>Faol</option>
                                            <option value="cancelled" <%= l.status==='cancelled'?'selected':'' %>>Bekor qilingan</option>
                                        </select>
                                    </td>
                                    <td>
                                        <button type="submit" class="btn btn-sm btn-primary mb-1">Saqlash</button>
                                </form>
                                        <form action="/admin/listing/delete/<%= l.id %>" method="POST" style="display:inline;">
                                            <button type="submit" class="btn btn-sm btn-danger">O'chirish</button>
                                        </form>
                                    </td>
                            </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Haydovchilar jadvali -->
        <div class="row">
            <div class="col-md-6">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-primary text-white"><b>Ro'yxatdan o'tgan Haydovchilar</b></div>
                    <div class="card-body table-responsive">
                        <table class="table table-sm table-striped">
                            <thead><tr><th>Ism</th><th>Tel</th><th>Mashina</th><th>Raqam</th></tr></thead>
                            <tbody>
                                <% DB.drivers.forEach(d => { %>
                                <tr><td><%= d.name %></td><td><%= d.phone %></td><td><%= d.carType %></td><td><%= d.licensePlate %></td></tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Yo'lovchilar jadvali -->
            <div class="col-md-6">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-success text-white"><b>Ro'yxatdan o'tgan Yo'lovchilar</b></div>
                    <div class="card-body table-responsive">
                        <table class="table table-sm table-striped">
                            <thead><tr><th>Ism</th><th>Telefon</th><th>Ro'yxat vaqti</th></tr></thead>
                            <tbody>
                                <% DB.passengers.forEach(p => { %>
                                <tr><td><%= p.name %></td><td><%= p.phone %></td><td><%= new Date(p.createdAt).toLocaleTimeString() %></td></tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</body>
</html>