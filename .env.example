# 7075.uz Telegram Bot MVP v1.0 Configuration

# Telegram Bot Token (BotFather'dan oling: https://t.me/BotFather)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Admin User ID (reyting va tasdiqlash uchun)
ADMIN_ID=123456789

# Database (keyinchalik PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/7075_bot

# API Server (keyinchalik)
# API_URL=http://localhost:3000

# Webhook (production uchun)
# WEBHOOK_URL=https://yourdomain.com/bot

# Port
PORT=3000

# Environment
NODE_ENV=development

# Logging
LOG_LEVEL=debug
